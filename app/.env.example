# Copy to .env.local for local development. On GitHub these come from
# repository variables (Settings -> Secrets and variables -> Actions -> Variables).
# Firebase web config is not secret; it's safe to expose in the built site.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# URL of the deployed Cloudflare Worker, e.g. https://peach-papers.<you>.workers.dev
VITE_WORKER_URL=
